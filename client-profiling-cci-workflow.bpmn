<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_ClientProfiling"
  targetNamespace="http://utmost.com/case-management/client-profiling">

  <bpmn:process id="client-profiling" name="Client Profiling - Change of Client Information" isExecutable="true">

    <bpmn:startEvent id="StartEvent_CaseCreated" name="Case created">
      <bpmn:outgoing>Flow_Start_To_Snapshot</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_TakeBusinessDataSnapshot" name="Take business data snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="take-business-data-snapshot" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Snapshot</bpmn:incoming>
      <bpmn:outgoing>Flow_Snapshot_To_InitiateDff</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_InitiateDffCase" name="Initiate a DFF-case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="initiate-dff-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Snapshot_To_InitiateDff</bpmn:incoming>
      <bpmn:outgoing>Flow_InitiateDff_To_UpdateMilestoneStart</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_UpdateMilestoneStart" name="Update Milestone in Connect">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-connect-milestone" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InitiateDff_To_UpdateMilestoneStart</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateMilestoneStart_To_Cci</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_ChangeClientInformation" name="Change of client information">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_UpdateMilestoneStart_To_Cci</bpmn:incoming>
      <bpmn:incoming>Flow_CciSignOffRejected_To_Cci</bpmn:incoming>
      <bpmn:outgoing>Flow_Cci_To_CciSignOff</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_CciSignOff" name="CCI Sign off">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Cci_To_CciSignOff</bpmn:incoming>
      <bpmn:outgoing>Flow_CciSignOff_To_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CciSignOffOk" name="Sign off OK?" default="Flow_CciSignOffRejected_To_Cci">
      <bpmn:incoming>Flow_CciSignOff_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CciSignOffApproved_To_Fork</bpmn:outgoing>
      <bpmn:outgoing>Flow_CciSignOffRejected_To_Cci</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gateway_DmaClassFork">
      <bpmn:incoming>Flow_CciSignOffApproved_To_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_To_Dma</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_To_UpdateClass</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_IntegrationWithDma" name="Integration with DMA">
      <bpmn:extensionElements><zeebe:taskDefinition type="integration-with-dma" retries="3" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_To_Dma</bpmn:incoming>
      <bpmn:outgoing>Flow_Dma_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_UpdateClassFields" name="Update CLASS fields">
      <bpmn:extensionElements><zeebe:taskDefinition type="update-class-fields" retries="3" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_To_UpdateClass</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateClass_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_DmaClassJoin">
      <bpmn:incoming>Flow_Dma_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_UpdateClass_To_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_To_ReturnClassMessage</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_ReturnMessageFromClass" name="Return message from CLASS">
      <bpmn:extensionElements><zeebe:taskDefinition type="return-message-from-class" retries="3" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_To_ReturnClassMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnClassMessage_To_ManualGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ManualActionRequired" name="Manual action to do?" default="Flow_NoManualAction_To_FinalMilestone">
      <bpmn:incoming>Flow_ReturnClassMessage_To_ManualGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualActionRequired_To_ManualChange</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoManualAction_To_FinalMilestone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ManualChange" name="Manual change">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ManualActionRequired_To_ManualChange</bpmn:incoming>
      <bpmn:incoming>Flow_ChangeSignOffRejected_To_ManualChange</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualChange_To_ChangeSignOff</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ChangeSignOff" name="Change Sign off">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ManualChange_To_ChangeSignOff</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeSignOff_To_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ChangeSignOffOk" name="Sign off OK?" default="Flow_ChangeSignOffRejected_To_ManualChange">
      <bpmn:incoming>Flow_ChangeSignOff_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeSignOffApproved_To_FinalMilestone</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChangeSignOffRejected_To_ManualChange</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_UpdateMilestoneFinal" name="Update Milestone in Connect">
      <bpmn:extensionElements><zeebe:taskDefinition type="update-connect-milestone" retries="3" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_NoManualAction_To_FinalMilestone</bpmn:incoming>
      <bpmn:incoming>Flow_ChangeSignOffApproved_To_FinalMilestone</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalMilestone_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Completed" name="Completed">
      <bpmn:incoming>Flow_FinalMilestone_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_To_Snapshot" sourceRef="StartEvent_CaseCreated" targetRef="Task_TakeBusinessDataSnapshot" />
    <bpmn:sequenceFlow id="Flow_Snapshot_To_InitiateDff" sourceRef="Task_TakeBusinessDataSnapshot" targetRef="Task_InitiateDffCase" />
    <bpmn:sequenceFlow id="Flow_InitiateDff_To_UpdateMilestoneStart" sourceRef="Task_InitiateDffCase" targetRef="Task_UpdateMilestoneStart" />
    <bpmn:sequenceFlow id="Flow_UpdateMilestoneStart_To_Cci" sourceRef="Task_UpdateMilestoneStart" targetRef="UserTask_ChangeClientInformation" />
    <bpmn:sequenceFlow id="Flow_Cci_To_CciSignOff" sourceRef="UserTask_ChangeClientInformation" targetRef="UserTask_CciSignOff" />
    <bpmn:sequenceFlow id="Flow_CciSignOff_To_Gateway" sourceRef="UserTask_CciSignOff" targetRef="Gateway_CciSignOffOk" />

    <bpmn:sequenceFlow id="Flow_CciSignOffApproved_To_Fork" name="Yes" sourceRef="Gateway_CciSignOffOk" targetRef="Gateway_DmaClassFork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cciSignOffApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CciSignOffRejected_To_Cci" name="No" sourceRef="Gateway_CciSignOffOk" targetRef="UserTask_ChangeClientInformation" />

    <bpmn:sequenceFlow id="Flow_Fork_To_Dma" sourceRef="Gateway_DmaClassFork" targetRef="Task_IntegrationWithDma" />
    <bpmn:sequenceFlow id="Flow_Fork_To_UpdateClass" sourceRef="Gateway_DmaClassFork" targetRef="Task_UpdateClassFields" />
    <bpmn:sequenceFlow id="Flow_Dma_To_Join" sourceRef="Task_IntegrationWithDma" targetRef="Gateway_DmaClassJoin" />
    <bpmn:sequenceFlow id="Flow_UpdateClass_To_Join" sourceRef="Task_UpdateClassFields" targetRef="Gateway_DmaClassJoin" />
    <bpmn:sequenceFlow id="Flow_Join_To_ReturnClassMessage" sourceRef="Gateway_DmaClassJoin" targetRef="Task_ReturnMessageFromClass" />
    <bpmn:sequenceFlow id="Flow_ReturnClassMessage_To_ManualGateway" sourceRef="Task_ReturnMessageFromClass" targetRef="Gateway_ManualActionRequired" />

    <bpmn:sequenceFlow id="Flow_ManualActionRequired_To_ManualChange" name="Yes" sourceRef="Gateway_ManualActionRequired" targetRef="UserTask_ManualChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualActionRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoManualAction_To_FinalMilestone" name="No" sourceRef="Gateway_ManualActionRequired" targetRef="Task_UpdateMilestoneFinal" />

    <bpmn:sequenceFlow id="Flow_ManualChange_To_ChangeSignOff" sourceRef="UserTask_ManualChange" targetRef="UserTask_ChangeSignOff" />
    <bpmn:sequenceFlow id="Flow_ChangeSignOff_To_Gateway" sourceRef="UserTask_ChangeSignOff" targetRef="Gateway_ChangeSignOffOk" />

    <bpmn:sequenceFlow id="Flow_ChangeSignOffApproved_To_FinalMilestone" name="Yes" sourceRef="Gateway_ChangeSignOffOk" targetRef="Task_UpdateMilestoneFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= changeSignOffApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChangeSignOffRejected_To_ManualChange" name="No" sourceRef="Gateway_ChangeSignOffOk" targetRef="UserTask_ManualChange" />

    <bpmn:sequenceFlow id="Flow_FinalMilestone_To_End" sourceRef="Task_UpdateMilestoneFinal" targetRef="EndEvent_Completed" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ClientProfiling">
    <bpmndi:BPMNPlane id="BPMNPlane_ClientProfiling" bpmnElement="client-profiling">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_CaseCreated"><dc:Bounds x="80" y="282" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Snapshot" bpmnElement="Task_TakeBusinessDataSnapshot"><dc:Bounds x="150" y="260" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InitiateDff" bpmnElement="Task_InitiateDffCase"><dc:Bounds x="340" y="260" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UpdateStart" bpmnElement="Task_UpdateMilestoneStart"><dc:Bounds x="500" y="260" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Cci" bpmnElement="UserTask_ChangeClientInformation"><dc:Bounds x="690" y="260" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CciSignOff" bpmnElement="UserTask_CciSignOff"><dc:Bounds x="890" y="260" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CciSignGateway" bpmnElement="Gateway_CciSignOffOk" isMarkerVisible="true"><dc:Bounds x="1050" y="275" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork" bpmnElement="Gateway_DmaClassFork"><dc:Bounds x="1150" y="275" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Dma" bpmnElement="Task_IntegrationWithDma"><dc:Bounds x="1240" y="190" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UpdateClass" bpmnElement="Task_UpdateClassFields"><dc:Bounds x="1240" y="330" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Join" bpmnElement="Gateway_DmaClassJoin"><dc:Bounds x="1420" y="275" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReturnClass" bpmnElement="Task_ReturnMessageFromClass"><dc:Bounds x="1510" y="260" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManualGateway" bpmnElement="Gateway_ManualActionRequired" isMarkerVisible="true"><dc:Bounds x="1700" y="275" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManualChange" bpmnElement="UserTask_ManualChange"><dc:Bounds x="1800" y="260" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ChangeSignOff" bpmnElement="UserTask_ChangeSignOff"><dc:Bounds x="1970" y="260" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ChangeSignGateway" bpmnElement="Gateway_ChangeSignOffOk" isMarkerVisible="true"><dc:Bounds x="2140" y="275" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_FinalMilestone" bpmnElement="Task_UpdateMilestoneFinal"><dc:Bounds x="2270" y="260" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_Completed"><dc:Bounds x="2460" y="282" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E1" bpmnElement="Flow_Start_To_Snapshot"><di:waypoint x="116" y="300"/><di:waypoint x="150" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="Flow_Snapshot_To_InitiateDff"><di:waypoint x="300" y="300"/><di:waypoint x="340" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="Flow_InitiateDff_To_UpdateMilestoneStart"><di:waypoint x="460" y="300"/><di:waypoint x="500" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="Flow_UpdateMilestoneStart_To_Cci"><di:waypoint x="640" y="300"/><di:waypoint x="690" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="Flow_Cci_To_CciSignOff"><di:waypoint x="840" y="300"/><di:waypoint x="890" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="Flow_CciSignOff_To_Gateway"><di:waypoint x="1010" y="300"/><di:waypoint x="1050" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="Flow_CciSignOffApproved_To_Fork"><di:waypoint x="1100" y="300"/><di:waypoint x="1150" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E8" bpmnElement="Flow_CciSignOffRejected_To_Cci"><di:waypoint x="1075" y="275"/><di:waypoint x="1075" y="120"/><di:waypoint x="765" y="120"/><di:waypoint x="765" y="260"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E9" bpmnElement="Flow_Fork_To_Dma"><di:waypoint x="1175" y="275"/><di:waypoint x="1175" y="230"/><di:waypoint x="1240" y="230"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E10" bpmnElement="Flow_Fork_To_UpdateClass"><di:waypoint x="1175" y="325"/><di:waypoint x="1175" y="370"/><di:waypoint x="1240" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E11" bpmnElement="Flow_Dma_To_Join"><di:waypoint x="1370" y="230"/><di:waypoint x="1445" y="230"/><di:waypoint x="1445" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E12" bpmnElement="Flow_UpdateClass_To_Join"><di:waypoint x="1370" y="370"/><di:waypoint x="1445" y="370"/><di:waypoint x="1445" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E13" bpmnElement="Flow_Join_To_ReturnClassMessage"><di:waypoint x="1470" y="300"/><di:waypoint x="1510" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E14" bpmnElement="Flow_ReturnClassMessage_To_ManualGateway"><di:waypoint x="1650" y="300"/><di:waypoint x="1700" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E15" bpmnElement="Flow_ManualActionRequired_To_ManualChange"><di:waypoint x="1750" y="300"/><di:waypoint x="1800" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E16" bpmnElement="Flow_NoManualAction_To_FinalMilestone"><di:waypoint x="1725" y="275"/><di:waypoint x="1725" y="100"/><di:waypoint x="2340" y="100"/><di:waypoint x="2340" y="260"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E17" bpmnElement="Flow_ManualChange_To_ChangeSignOff"><di:waypoint x="1920" y="300"/><di:waypoint x="1970" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E18" bpmnElement="Flow_ChangeSignOff_To_Gateway"><di:waypoint x="2090" y="300"/><di:waypoint x="2140" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E19" bpmnElement="Flow_ChangeSignOffApproved_To_FinalMilestone"><di:waypoint x="2190" y="300"/><di:waypoint x="2270" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E20" bpmnElement="Flow_ChangeSignOffRejected_To_ManualChange"><di:waypoint x="2165" y="325"/><di:waypoint x="2165" y="450"/><di:waypoint x="1860" y="450"/><di:waypoint x="1860" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E21" bpmnElement="Flow_FinalMilestone_To_End"><di:waypoint x="2410" y="300"/><di:waypoint x="2460" y="300"/></bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
